# MSX Media Server Environment Variables
# Create these as environment variables on your Vercel project settings.

# TMDB API Key (required)
# Get from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# SubDL API Key (optional)
# For subtitle functionality
SUBDL_API_KEY=your_subdl_api_key_here

# Sports Sources (optional)
# Only use sources you are authorized to redistribute.
# Format: valid stream URL or null
FOOTBALL_SOURCE=
CRICKET_SOURCE=
F1_SOURCE=

# Note: Do NOT commit this file to version control.
# Do NOT put actual API keys in this file.
# Copy this file to .env.local for local development only.
